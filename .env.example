# Copy to .env.local and fill in real values. Never commit .env.local.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Local dev DB (see docker-compose.yml). Swap for a hosted Postgres
# (Neon/Supabase/Vercel Postgres) URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pitchiq

# Langfuse UI -> Settings -> API Keys. Base URL depends on your data region
# (EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com) or
# your self-hosted URL.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
# Keeps local traces separate from production in the Langfuse UI/dashboards.
LANGFUSE_TRACING_ENVIRONMENT=development
