# Copy to .env.local and fill in real values. Never commit .env.local.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Local dev DB (see docker-compose.yml). Swap for a hosted Postgres
# (Neon/Supabase/Vercel Postgres) URL in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pitchiq
